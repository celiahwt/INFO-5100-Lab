<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane xmlns:fx="http://javafx.com/fxml/1" 
            xmlns="http://javafx.com/javafx/8" 
            fx:controller="controller.MainFXMLController"
            prefHeight="400.0" prefWidth="600.0">

   <children>
      <Label layoutX="210.0" layoutY="50.0" text="Registration Form">
         <font>
            <Font name="System Bold" size="24.0" />
         </font>
      </Label>

      <Label layoutX="140.0" layoutY="120.0" text="Name:" />
      <Label layoutX="140.0" layoutY="160.0" text="Age:" />
      <Label layoutX="140.0" layoutY="200.0" text="Email:" />

      <TextField fx:id="nameTextField" layoutX="240.0" layoutY="115.0" prefWidth="200.0" />
      <Spinner fx:id="ageSpinner" layoutX="240.0" layoutY="155.0" prefWidth="200.0" />
      <TextField fx:id="emailTextField" layoutX="240.0" layoutY="195.0" prefWidth="200.0" />

      <Button layoutX="260.0" layoutY="250.0" text="Submit" prefWidth="100.0" onAction="#submit" />
   </children>
</AnchorPane>
